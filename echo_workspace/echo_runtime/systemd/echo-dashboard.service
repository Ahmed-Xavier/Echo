[Unit]
Description=Echo Runtime Dashboard Web Server
After=network-online.target echo-rosbridge.service echo-launch-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ahmed/.openclaw/workspace/github_echo/echo_workspace/echo_runtime/dashboard
ExecStart=/usr/bin/python3 -m http.server 8088 --bind 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
