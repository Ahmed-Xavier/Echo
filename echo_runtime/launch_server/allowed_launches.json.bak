{
  "actions": {
    "mapping": {
      "label": "Mapping",
      "enabled": true,
      "exclusive_group": "robot_stack",
      "command": [
        "bash",
        "-lc",
        "set -e\nsource ~/echo_runtime/bin/echo_env.sh\n\nLOG_DIR=~/echo_runtime/logs\nmkdir -p \"$LOG_DIR\"\n\nESP32_PORT=\"/dev/serial/by-path/platform-xhci-hcd.1-usb-0:1:1.0-port0\"\nESP32_BAUD=\"115200\"\nYDLIDAR_SRC=\"$HOME/.openclaw/workspace/github_echo/echo_workspace/src/ydlidar_ros2_driver\"\nYDLIDAR_PARAMS=\"$YDLIDAR_SRC/params/ydlidar.yaml\"\n\nPIDS=\"\"\n\nstart_bg() {\n  NAME=\"$1\"\n  CMD=\"$2\"\n  LOG=\"$LOG_DIR/$NAME.log\"\n\n  echo \"[mapping] starting $NAME\"\n  bash -lc \"$CMD\" > \"$LOG\" 2>&1 &\n  PID=$!\n  PIDS=\"$PIDS $PID\"\n  echo \"[mapping] $NAME pid=$PID log=$LOG\"\n}\n\ncleanup() {\n  echo \"[mapping] stopping mapping stack\"\n  for PID in $PIDS; do\n    kill \"$PID\" 2>/dev/null || true\n  done\n  sleep 2\n  for PID in $PIDS; do\n    kill -9 \"$PID\" 2>/dev/null || true\n  done\n  wait $PIDS 2>/dev/null || true\n}\ntrap cleanup EXIT INT TERM\n\nwait_for_topic() {\n  TOPIC=\"$1\"\n  TIMEOUT=\"${2:-30}\"\n  echo \"[mapping] waiting for $TOPIC\"\n  end=$((SECONDS + TIMEOUT))\n  while [ \"$SECONDS\" -lt \"$end\" ]; do\n    if ros2 topic list | grep -qx \"$TOPIC\"; then\n      echo \"[mapping] found $TOPIC\"\n      return 0\n    fi\n    sleep 1\n  done\n  echo \"[mapping] ERROR: timed out waiting for $TOPIC\"\n  return 1\n}\n\nwait_for_node() {\n  NODE=\"$1\"\n  TIMEOUT=\"${2:-30}\"\n  echo \"[mapping] waiting for node $NODE\"\n  end=$((SECONDS + TIMEOUT))\n  while [ \"$SECONDS\" -lt \"$end\" ]; do\n    if ros2 node list | grep -qx \"$NODE\"; then\n      echo \"[mapping] found node $NODE\"\n      return 0\n    fi\n    sleep 1\n  done\n  echo \"[mapping] ERROR: timed out waiting for node $NODE\"\n  return 1\n}\n\necho \"[mapping] Echo mapping stack starting\"\necho \"[mapping] ESP32: $ESP32_PORT\"\necho \"[mapping] LiDAR params: $YDLIDAR_PARAMS\"\n\nstart_bg micro_ros_agent \"ros2 run micro_ros_agent micro_ros_agent serial --dev '$ESP32_PORT' -b '$ESP32_BAUD' -v4\"\nwait_for_node /esp32_echo_node 45\nwait_for_topic /imu/data_raw 20\n\nstart_bg ydlidar \"ros2 launch '$YDLIDAR_SRC/launch/ydlidar_launch.py' params_file:='$YDLIDAR_PARAMS'\"\nwait_for_topic /scan 30\n\nstart_bg esp32_encoder_odometry \"ros2 run robot_controller esp32_encoder_odometry\"\nwait_for_topic /wheel_odom 20\n\nstart_bg ekf \"ros2 launch echo_bringup ekf_launch.py\"\nwait_for_topic /odometry/filtered 20\n\nstart_bg slam \"ros2 launch echo_bringup slam_launch.py\"\nwait_for_node /slam_toolbox 30\n\necho \"[mapping] configuring slam_toolbox\"\nros2 lifecycle set /slam_toolbox configure || true\nsleep 2\n\necho \"[mapping] activating slam_toolbox\"\nros2 lifecycle set /slam_toolbox activate || true\nsleep 4\n\nwait_for_topic /map 30\n\necho \"[mapping] mapping stack online\"\necho \"[mapping] topics: /scan /wheel_odom /odometry/filtered /map\"\necho \"[mapping] fixed frame for Foxglove: map\"\n\nwait"
      ]
    },
    "navigation": {
      "label": "Navigation",
      "enabled": true,
      "exclusive_group": "robot_stack",
      "command": [
        "bash",
        "-lc",
        "set -e\nsource ~/echo_runtime/bin/echo_env.sh\n\nLOG_DIR=~/echo_runtime/logs\nmkdir -p \"$LOG_DIR\"\n\nESP32_PORT=\"/dev/serial/by-path/platform-xhci-hcd.1-usb-0:1:1.0-port0\"\nESP32_BAUD=\"115200\"\nYDLIDAR_SRC=\"$HOME/.openclaw/workspace/github_echo/echo_workspace/src/ydlidar_ros2_driver\"\nYDLIDAR_PARAMS=\"$YDLIDAR_SRC/params/ydlidar.yaml\"\nMAP_FILE=\"$HOME/echo_runtime/maps/echo_current_map.yaml\"\nNAV2_PARAMS=\"$HOME/echo_runtime/nav2_runtime_params.yaml\"\n\nPIDS=\"\"\n\nstart_bg() {\n  NAME=\"$1\"\n  CMD=\"$2\"\n  LOG=\"$LOG_DIR/navigation_$NAME.log\"\n\n  echo \"[navigation] starting $NAME\"\n  bash -lc \"$CMD\" > \"$LOG\" 2>&1 &\n  PID=$!\n  PIDS=\"$PIDS $PID\"\n  echo \"[navigation] $NAME pid=$PID log=$LOG\"\n}\n\ncleanup() {\n  echo \"[navigation] stopping navigation stack\"\n  for PID in $PIDS; do\n    kill \"$PID\" 2>/dev/null || true\n  done\n  sleep 2\n  for PID in $PIDS; do\n    kill -9 \"$PID\" 2>/dev/null || true\n  done\n\n  pkill -f \"nav2_bringup.*bringup_launch.py\" 2>/dev/null || true\n  pkill -f \"component_container_isolated.*nav2_container\" 2>/dev/null || true\n  pkill -f \"component_container.*nav2_container\" 2>/dev/null || true\n  wait $PIDS 2>/dev/null || true\n}\ntrap cleanup EXIT INT TERM\n\nwait_for_topic() {\n  TOPIC=\"$1\"\n  TIMEOUT=\"${2:-30}\"\n  echo \"[navigation] waiting for $TOPIC\"\n  end=$((SECONDS + TIMEOUT))\n  while [ \"$SECONDS\" -lt \"$end\" ]; do\n    if ros2 topic list | grep -qx \"$TOPIC\"; then\n      echo \"[navigation] found $TOPIC\"\n      return 0\n    fi\n    sleep 1\n  done\n  echo \"[navigation] ERROR: timed out waiting for $TOPIC\"\n  return 1\n}\n\nwait_for_node() {\n  NODE=\"$1\"\n  TIMEOUT=\"${2:-30}\"\n  echo \"[navigation] waiting for node $NODE\"\n  end=$((SECONDS + TIMEOUT))\n  while [ \"$SECONDS\" -lt \"$end\" ]; do\n    if ros2 node list | grep -qx \"$NODE\"; then\n      echo \"[navigation] found node $NODE\"\n      return 0\n    fi\n    sleep 1\n  done\n  echo \"[navigation] ERROR: timed out waiting for node $NODE\"\n  return 1\n}\n\necho \"[navigation] Echo navigation stack starting\"\necho \"[navigation] ESP32: $ESP32_PORT\"\necho \"[navigation] LiDAR params: $YDLIDAR_PARAMS\"\necho \"[navigation] map: $MAP_FILE\"\necho \"[navigation] nav2 params: $NAV2_PARAMS\"\n\nif [ ! -f \"$MAP_FILE\" ]; then\n  echo \"[navigation] ERROR: missing map file $MAP_FILE\"\n  exit 1\nfi\n\nif [ ! -f \"$NAV2_PARAMS\" ]; then\n  echo \"[navigation] ERROR: missing nav2 params $NAV2_PARAMS\"\n  exit 1\nfi\n\nstart_bg micro_ros_agent \"ros2 run micro_ros_agent micro_ros_agent serial --dev '$ESP32_PORT' -b '$ESP32_BAUD' -v4\"\nwait_for_node /esp32_echo_node 45\nwait_for_topic /imu/data_raw 20 || echo \"[navigation] WARN: /imu/data_raw not listed yet; continuing because /esp32_echo_node is present\"\n\nstart_bg ydlidar \"ros2 launch '$YDLIDAR_SRC/launch/ydlidar_launch.py' params_file:='$YDLIDAR_PARAMS'\"\nwait_for_topic /scan 30\n\nstart_bg esp32_encoder_odometry \"ros2 run robot_controller esp32_encoder_odometry\"\nwait_for_topic /wheel_odom 20\n\nstart_bg ekf \"ros2 launch echo_bringup ekf_launch.py\"\nwait_for_topic /odometry/filtered 20\n\nstart_bg nav2 \"ros2 launch nav2_bringup bringup_launch.py map:='$MAP_FILE' params_file:='$NAV2_PARAMS' use_sim_time:=false autostart:=true\"\nwait_for_node /bt_navigator 45\nwait_for_topic /map 30\nwait_for_topic /amcl_pose 30\n\necho \"[navigation] navigation stack online\"\necho \"[navigation] topics: /map /amcl_pose /goal_pose /cmd_vel\"\necho \"[navigation] fixed frame for Foxglove/dashboard: map\"\n\nwait"
      ]
    },
    "camera": {
      "label": "Camera",
      "enabled": true,
      "exclusive_group": "camera",
      "command": [
        "bash",
        "-lc",
        "set -e\nsource ~/echo_runtime/bin/echo_env.sh\n\nLOG_DIR=~/echo_runtime/logs\nmkdir -p \"$LOG_DIR\"\n\necho \"[camera] starting camera publisher on index 8\"\npython3 /home/ahmed/.openclaw/workspace/github_echo/echo_workspace/src/echo_perception/scripts/camera_publisher.py \\\n  --ros-args \\\n  -p camera_index:=8 \\\n  -p width:=640 \\\n  -p height:=480 \\\n  -p fps:=15.0 \\\n  > \"$LOG_DIR/camera_publisher.log\" 2>&1 &\nCAMERA_PID=$!\n\nsleep 3\n\necho \"[camera] starting apriltag detector\"\npython3 /home/ahmed/.openclaw/workspace/github_echo/echo_workspace/src/echo_perception/scripts/apriltag_detector.py \\\n  > \"$LOG_DIR/apriltag_detector.log\" 2>&1 &\nAPRILTAG_PID=$!\n\ncleanup() {\n  echo \"[camera] stopping camera pipeline\"\n  kill \"$CAMERA_PID\" \"$APRILTAG_PID\" 2>/dev/null || true\n  wait \"$CAMERA_PID\" \"$APRILTAG_PID\" 2>/dev/null || true\n}\ntrap cleanup EXIT INT TERM\n\necho \"[camera] pipeline online\"\necho \"[camera] dashboard topic: /apriltag/annotated_image/compressed\"\n\nwait"
      ]
    },
    "foxglove": {
      "label": "Foxglove Bridge",
      "enabled": true,
      "exclusive_group": "debug_bridge",
      "command": [
        "bash",
        "-lc",
        "source ~/echo_runtime/bin/echo_env.sh && ros2 launch foxglove_bridge foxglove_bridge_launch.xml port:=8765"
      ]
    },
    "stop_stack": {
      "label": "Stop Echo Stack",
      "enabled": true,
      "exclusive_group": null,
      "command": [
        "bash",
        "-lc",
        "set -e\nsource ~/echo_runtime/bin/echo_env.sh\n\necho \"[stop_stack] stopping dashboard robot stack targets\"\n\npkill -f \"micro_ros_agent.*serial\" 2>/dev/null || true\npkill -f \"esp32_encoder_odometry\" 2>/dev/null || true\npkill -f \"ekf_node\" 2>/dev/null || true\npkill -f \"sync_slam_toolbox_node\" 2>/dev/null || true\npkill -f \"slam_toolbox\" 2>/dev/null || true\npkill -f \"ydlidar_ros2_driver_node\" 2>/dev/null || true\npkill -f \"static_transform_publisher 0.0275 0 0.160.*base_link laser_frame\" 2>/dev/null || true\npkill -f \"map_server\" 2>/dev/null || true\npkill -f \"amcl\" 2>/dev/null || true\npkill -f \"component_container.*nav2_container\" 2>/dev/null || true\npkill -f \"component_container_isolated.*nav2_container\" 2>/dev/null || true\npkill -f \"nav2_bringup.*bringup_launch.py\" 2>/dev/null || true\n\nsleep 2\n\necho \"[stop_stack] done\""
      ]
    },
    "save_map": {
      "label": "Save Map",
      "enabled": true,
      "exclusive_group": null,
      "command": [
        "bash",
        "-lc",
        "set -e\nsource ~/echo_runtime/bin/echo_env.sh\n\nMAP_DIR=~/echo_runtime/maps\nmkdir -p \"$MAP_DIR\"\n\nSTAMP=$(date +%Y%m%d_%H%M%S)\nLATEST=\"$MAP_DIR/echo_current_map\"\nSNAPSHOT=\"$MAP_DIR/echo_map_$STAMP\"\n\necho \"[save_map] saving latest map to $LATEST\"\nros2 run nav2_map_server map_saver_cli -f \"$LATEST\"\n\necho \"[save_map] copying timestamped snapshot to $SNAPSHOT\"\ncp \"$LATEST.pgm\" \"$SNAPSHOT.pgm\"\ncp \"$LATEST.yaml\" \"$SNAPSHOT.yaml\"\n\necho \"[save_map] saved:\"\necho \"[save_map] $LATEST.pgm\"\necho \"[save_map] $LATEST.yaml\"\necho \"[save_map] $SNAPSHOT.pgm\"\necho \"[save_map] $SNAPSHOT.yaml\""
      ]
    }
  }
}
