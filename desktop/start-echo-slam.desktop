[Desktop Entry]
Type=Application
Name=Start Echo SLAM
Comment=Launch Echo ESP32 SLAM stack with rosboard and Xbox teleop
Exec=gnome-terminal --title="Echo SLAM" -- bash -lc "cd \"$HOME/echo_workspace\" && ./src/echo_bringup/scripts/start_echo_slam_esp32.sh; echo; read -p 'Press Enter to close...'"
Icon=utilities-terminal
Terminal=false
Categories=Development;Robotics;
